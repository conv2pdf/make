    },
    {
        "name": "format",
        "type": "select",
        "label": "Image format",
        "required": true,
        "default": "png",
        "options": [
            {
                "label": "PNG",
                "value": "png"
            },
            {
                "label": "JPG",
                "value": "jpg"
            }
        ]
    },
    {
        "name": "password",
        "type": "text",
        "label": "PDF password",
