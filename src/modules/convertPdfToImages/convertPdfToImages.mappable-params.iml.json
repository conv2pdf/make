[
    {
        "name": "fileName",
        "type": "filename",
        "label": "File name",
        "required": true,
        "semantic": "file:name",
        "help": "Name of the file, with its extension. For example, `report.pdf`."
    },
    {
        "name": "data",
        "type": "buffer",
        "label": "Data",
        "required": true,
        "semantic": "file:data",
