[
    {
        "name": "files",
        "type": "array",
        "label": "PDFs",
        "required": true,
        "help": "PDFs to merge, in order. Add one item per PDF, or map an array of files from an Array aggregator.",
        "validate": {
            "minItems": 2,
            "maxItems": 20
        },
        "spec": [
            {
                "name": "options",
                "type": "collection",
                "label": "File",
                "required": true,
                "spec": [
                    {
                        "name": "filename",
                        "type": "filename",
                        "label": "File name",
                        "required": true,
                        "semantic": "file:name",
                        "help": "Name of the PDF, with its extension. For example, `part-1.pdf`."
                    }
                ]
            },
            {
                "name": "value",
                "type": "buffer",
                "label": "Data",
                "required": true,
                "semantic": "file:data"
            }
        ]
    }
]
